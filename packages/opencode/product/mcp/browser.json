{
  "mcp": {
    "browser": {
      "type": "local",
      "command": [
        "node",
        "{env:HARNESS_BROWSER_MCP_ENTRY}",
        "--headless={env:HARNESS_BROWSER_HEADLESS}",
        "--autoConnect={env:HARNESS_BROWSER_AUTO_CONNECT}",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "environment": {
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1",
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
      },
      "timeout": 120000
    }
  }
}
