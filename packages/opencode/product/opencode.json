{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "default",
  "snapshot": false,
  "agent": {
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "provider": {
    "platform": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Model Gateway",
      "options": {
        "baseURL": "https://openrouter.ai/api/v1",
        "streaming": false
      }
    }
  },
  "enabled_providers": [
    "platform"
  ],
  "instructions": [
    "{env:HARNESS_MEMORY_DIR}/MEMORY.md"
  ],
  "skills": {
    "paths": [
      "{env:HARNESS_PRODUCT_DIR}/skills"
    ]
  },
  "mcp": {
    "browser": {
      "type": "local",
      "command": [
        "node",
        "{env:HARNESS_BROWSER_MCP_ENTRY}",
        "--headless={env:HARNESS_BROWSER_HEADLESS}",
        "--autoConnect={env:HARNESS_BROWSER_AUTO_CONNECT}",
        "--no-usage-statistics",
        "--no-performance-crux"
      ],
      "environment": {
        "CHROME_DEVTOOLS_MCP_NO_UPDATE_CHECKS": "1",
        "CHROME_DEVTOOLS_MCP_NO_USAGE_STATISTICS": "1"
      },
      "timeout": 120000
    }
  },
  "permission": {
    "external_directory": {
      "{env:HARNESS_MEMORY_DIR}/*": "allow"
    },
    "read": {
      "*{env:HARNESS_MEMORY_DIR}/*": "allow"
    },
    "edit": {
      "*{env:HARNESS_MEMORY_DIR}/*": "allow"
    },
    "bash": {
      "*{env:HARNESS_MEMORY_DIR}*": "deny"
    }
  }
}
